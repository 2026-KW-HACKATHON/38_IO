{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/assets/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
